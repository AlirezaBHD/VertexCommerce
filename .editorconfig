root = true

[*.cs]
charset = utf-8
indent_style = space
indent_size = 4

# Suppress ReSharper's static unlimited string length warning globally.
# Reason: We use [StringField] attribute + StringFieldConvention + a strict model-based guard test.
# ReSharper's static analysis does not recognize derived attributes or conventions.
resharper_entity_framework_model_validation_unlimited_string_length_highlighting = none
